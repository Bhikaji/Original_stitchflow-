--
-- Structure for view `v_item_stock`
--
DROP TABLE IF EXISTS `v_item_stock`;

CREATE ALGORITHM=UNDEFINED DEFINER=`kenerp`@`localhost` SQL SECURITY DEFINER VIEW `v_item_stock`  AS SELECT `v_stock_ledger`.`item_name` AS `item_name`, greatest(0,(sum(`v_stock_ledger`.`qty_in`) - sum(`v_stock_ledger`.`qty_out`))) AS `stock_qty` FROM `v_stock_ledger` WHERE ((`v_stock_ledger`.`item_name` is not null) AND (`v_stock_ledger`.`item_name` <> '')) GROUP BY `v_stock_ledger`.`item_name` ;

-- --------------------------------------------------------

--
-- Structure for view `v_po_received`
--
DROP TABLE IF EXISTS `v_po_received`;

CREATE ALGORITHM=UNDEFINED DEFINER=`kenerp`@`localhost` SQL SECURITY DEFINER VIEW `v_po_received`  AS SELECT `p`.`po_no` AS `po_no`, `li`.`name` AS `item_name`, `li`.`color` AS `color`, `li`.`qty` AS `po_qty`, coalesce((select sum(`ii`.`rec_qty`) from (`inward_items` `ii` join `inwards` `iw` on((`iw`.`id` = `ii`.`inward_id`))) where ((`iw`.`po_ref` = `p`.`po_no`) and (lower(`ii`.`name`) = lower(`li`.`name`)))),0) AS `received_qty` FROM (`purchase_order_items` `li` join `purchase_orders` `p` on((`p`.`id` = `li`.`po_id`))) ;

-- --------------------------------------------------------

--
-- Structure for view `v_stock_ledger`
--
DROP TABLE IF EXISTS `v_stock_ledger`;

CREATE ALGORITHM=UNDEFINED DEFINER=`kenerp`@`localhost` SQL SECURITY DEFINER VIEW `v_stock_ledger`  AS SELECT `w`.`inward_date` AS `txn_date`, 'inward' AS `txn_type`, `w`.`inward_no` AS `ref_no`, `i`.`name` AS `item_name`, `i`.`rec_qty` AS `qty_in`, 0 AS `qty_out` FROM (`inward_items` `i` join `inwards` `w` on((`w`.`id` = `i`.`inward_id`)))union all select `jr`.`return_date` AS `return_date`,'jobwork_return' AS `jobwork_return`,`jr`.`return_no` AS `return_no`,`ji`.`name` AS `name`,`ji`.`ret_qty` AS `ret_qty`,0 AS `0` from (`jobwork_return_items` `ji` join `jobwork_returns` `jr` on((`jr`.`id` = `ji`.`return_id`))) union all select coalesce(`x`.`issue_date`,`j`.`jw_date`) AS `COALESCE(x.issue_date, j.jw_date)`,'jobwork_issue' AS `jobwork_issue`,`j`.`jw_no` AS `jw_no`,`x`.`item` AS `item`,0 AS `0`,`x`.`qty` AS `qty` from (`jobwork_issues` `x` join `jobworks` `j` on((`j`.`id` = `x`.`jobwork_id`))) where (`j`.`doc_type` = 'jobwork') union all select `pr`.`return_date` AS `return_date`,'purchase_return' AS `purchase_return`,`pr`.`return_no` AS `return_no`,`pi`.`name` AS `name`,0 AS `0`,`pi`.`ret_qty` AS `ret_qty` from (`purchase_return_items` `pi` join `purchase_returns` `pr` on((`pr`.`id` = `pi`.`return_id`)))  ;

