--
-- Table structure for table `items`
--

CREATE TABLE `items` (
  `row_seq` bigint UNSIGNED NOT NULL,
  `id` varchar(40) COLLATE utf8mb4_unicode_ci NOT NULL,
  `code` varchar(24) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `name` varchar(190) COLLATE utf8mb4_unicode_ci NOT NULL,
  `category` varchar(190) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `classification` varchar(190) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `material_type` varchar(190) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `quality` varchar(190) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `description` text COLLATE utf8mb4_unicode_ci,
  `unit` varchar(24) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `width` varchar(120) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `hsn` varchar(24) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `gst` decimal(6,2) DEFAULT NULL,
  `image` longtext COLLATE utf8mb4_unicode_ci,
  `is_active` tinyint(1) NOT NULL DEFAULT '1',
  `has_color` tinyint(1) NOT NULL DEFAULT '0',
  `color_name` varchar(190) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `moq` varchar(60) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `item_rate` varchar(60) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `item_mrp` varchar(60) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `cgst` varchar(60) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `sgst` varchar(60) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `igst` varchar(60) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `purchase_rate` varchar(60) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `sale_rate` varchar(60) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `extra_json` longtext COLLATE utf8mb4_unicode_ci,
  `created_by` varchar(120) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `updated_by` varchar(120) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `created_at` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

