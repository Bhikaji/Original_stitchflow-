# StitchFlow ERP — Production Environment Configuration Template
# Copy this file to .env and configure with your production database credentials.

# Database Connection Settings
STITCHFLOW_DB_HOST=127.0.0.1
STITCHFLOW_DB_PORT=3306
STITCHFLOW_DB_NAME=your_database_name
STITCHFLOW_DB_USER=your_database_user
STITCHFLOW_DB_PASS=your_strong_database_password

# Automated Backup Settings (backup_database.php)
# STITCHFLOW_BACKUP_EMAIL=backups@yourdomain.com
# STITCHFLOW_DRIVE_FOLDER_ID=your_google_drive_folder_id
# STITCHFLOW_GOOGLE_CLIENT_ID=your_client_id
# STITCHFLOW_GOOGLE_CLIENT_SECRET=your_client_secret
# STITCHFLOW_GOOGLE_REFRESH_TOKEN=your_refresh_token
